From c3f2b1dcfb60c14d28c07d10e8315aa0b7405360 Mon Sep 17 00:00:00 2001
From: yuji mitobe <mitobex7@gmail.com>
Date: Sat, 22 Aug 2026 03:18:48 +0900
Subject: [PATCH 2/3] arm64: dts: qcom: sm7325-nothing-spacewar: describe
 haptics on SoundWire

PM8350B exposes a SoundWire haptics peripheral on the RX SoundWire bus.
It enumerates as manufacturer 0x0217, part 0xf001, class 0x00 and unique
ID 0, but Spacewar has no firmware node for it.

Without a firmware node SoundWire uses zero-initialized peripheral
properties, so simple_clk_stop_capable is false. Clock-stop exit then
waits for the full prepare/deprepare state machine and times out with
clock stop deprepare wait failed:-110.

Describe the peripheral and mark its simplified clock-stop-prepare state
machine. Runtime testing on Nothing Phone (1) showed that setting this
capability removes the deprepare timeout.

Signed-off-by: yuji mitobe <mitobex7@gmail.com>
---
 arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
index 39dd5a52c170..e11bd47a18b0 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
@@ -1594,6 +1594,13 @@ focaltech@0 {
 &swr0 {
 	status = "okay";
 
+	haptics@0,0 {
+		compatible = "sdw20217f00100";
+		reg = <0 0>;
+
+		mipi-sdw-simplified-clockstopprepare-sm-supported;
+	};
+
 	wcd_rx: codec@0,4 {
 		compatible = "sdw20217010d00";
 		reg = <0 4>;
-- 
